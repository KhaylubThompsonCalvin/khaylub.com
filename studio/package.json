{
  "name": "khaylub-studio",
  "private": true,
  "type": "module",
  "description": "The owner's private publishing Studio (Keystatic on Astro, Node adapter). Separate from the public site; never part of its build.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "vocabulary": "node scripts/vocabulary.mjs",
    "dev": "npm run vocabulary && astro dev",
    "build": "node scripts/check-storage.mjs && npm run vocabulary && astro build",
    "start": "node ./dist/server/entry.mjs",
    "check": "npm run vocabulary && astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.6",
    "@astrojs/react": "^6.0.6",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.9",
    "astro": "^7.3.3",
    "js-yaml": "^4.1.0",
    "react": "~19.2.0",
    "react-dom": "~19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.0"
  }
}
