---
// Maps a catalog entry onto the Card pattern.
import Card from './Card.astro';
import ProjectFacts from './ProjectFacts.astro';
import { badgeFor, evidenceFor, labelFor, routeFor, termRoute, type AnyEntry } from '@lib/catalog';
import { pictureFor } from '@lib/media';

interface Props {
  entry: AnyEntry;
  rank?: number;
  showCollection?: boolean;
  /** Featured cards on Work: outcome, technologies, and proof links from the frontmatter. */
  detail?: boolean;
}
const { entry, rank, showCollection = false, detail = false } = Astro.props;
const badge = badgeFor(entry);
const date = entry.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const meta = [date];
const plain = showCollection && entry.collection !== 'projects' && entry.collection !== 'data';
if (plain) meta.unshift(badge.text);
// Every card leads with a picture (the 2026-10-10 polish): the entry's cover or the first picture it
// publishes (pictureFor, a 400 px WebP), else a calling card with the kind and one line of its own:
// its main tag, else its year (the technologies are its chips).
const status = entry.collection === 'projects' ? (entry.data as { project_status?: string }).project_status : undefined;
const thumb = await pictureFor(entry);
const tag = entry.data.tags?.[0];
// A project or data card names up to three of its technologies as chips (each to its page when it
// has one), then how many more; Work's featured cards list them all in their facts instead.
const techs: string[] = ['projects', 'data'].includes(entry.collection) && !detail ? ((entry.data as { technologies?: string[] }).technologies ?? []) : [];
const withPage = new Set((await evidenceFor('technologies')).map((t) => t.slug));
const chips = techs.slice(0, 3).map((s) => ({ label: labelFor('technologies', s), href: withPage.has(s) ? termRoute('technologies', s) : undefined }));
const more = techs.length - chips.length;
const call = { kind: entry.collection, fact: tag ? labelFor('tags', tag) : String(entry.data.date.getUTCFullYear()) };
---

<Card href={routeFor(entry)} title={entry.data.title} summary={entry.data.summary} badge={plain ? undefined : badge} meta={meta} rank={rank} thumb={thumb} call={call} status={status}>
  {detail && <ProjectFacts entry={entry} compact />}
  {
    chips.length > 0 && (
      <><span class="visually-hidden">Technologies:</span><ul class="chips">
        {chips.map((c) => <li>{c.href ? <a class="chip" href={c.href}>{c.label}</a> : <span class="chip">{c.label}</span>}</li>)}
        {more > 0 && <li class="chip">+{more}</li>}
      </ul></>
    )
  }
  {/* Callers may add a line under the summary (the related rail's one-line reason). */}
  <slot />
</Card>
