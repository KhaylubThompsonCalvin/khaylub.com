---
// The Home identity block (the first and widest block of the Home grid; the owner's requests of
// 2026-10-10): the name, the role line and the place, the availability statement with its date, the
// quick links, and the two doors, with the portrait large in the block's right column (280 px from
// 1024 px, 240 px from 640 px). On a phone the portrait (160 px) opens the block above the name,
// never between the statement and the doors, so the name, the role, the availability, and both doors
// are on the first screen at 390 by 844 and 1440 by 900. The widths cover 1x to 3x of each displayed size, up to
// the source; sizes states the displayed width exactly.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { identity, availability, monthLabel } from '@lib/profile';
import RecruiterRow from './RecruiterRow.astro';
import Doors from './Doors.astro';

const id = identity();
const avail = availability();

// The portrait is a file under src/assets/profile/, named by `photo` in the profile, so the build
// derives the sized AVIF and WebP variants from one lossless source.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile/*.{png,jpg,webp}', { eager: true });
const photo = id.photo ? portraits[`/src/assets/profile/${id.photo}`]?.default : undefined;
if (id.photo && !photo) throw new Error(`identity.yaml photo "${id.photo}" is not a file under src/assets/profile/`);
---

<section class="hero" aria-labelledby="site-name">
  <div class="id-head">
    <h1 id="site-name">{id.name}</h1>
    {
      photo && (
        <span class="id-photo">
          <Picture
            src={photo}
            alt={id.photo_alt}
            widths={[160, 240, 280, 320, 480, 560, 840, 972]}
            sizes="(min-width: 1024px) 280px, (min-width: 640px) 240px, 160px"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </span>
      )
    }
  </div>
  <p class="role muted">{id.role_line} · {id.location}</p>
  <p class="availability">
    {avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small>
  </p>
  <RecruiterRow />
  <Doors />
</section>

<style is:global>
  /* On a phone the portrait comes first, then the name. */
  .id-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .hero h1 {
    grid-row: 2;
    font-size: clamp(1.875rem, 4vw, 3.25rem);
    margin: 0;
  }
  /* The portrait: 3 by 4, cropped on the face, rounded; centred on a phone. */
  .id-photo {
    justify-self: center;
  }
  .id-photo img {
    width: 160px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: var(--radius-photo);
  }
  /* From 640 px the words take the first column and the portrait the second, top aligned. */
  @media (min-width: 640px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: repeat(4, auto) 1fr;
      column-gap: var(--space-4);
    }
    /* The rows stay tight under the name; the doors keep to the foot, level with the portrait's. */
    .hero .doors {
      align-self: end;
    }
    .id-head {
      display: contents;
    }
    .hero > *,
    .hero h1 {
      grid-column: 1;
    }
    .hero h1 {
      grid-row: auto;
      margin-bottom: var(--space-2);
    }
    .hero .id-photo {
      grid-column: 2;
      grid-row: 1 / span 5;
    }
    .id-photo img {
      width: 240px;
    }
  }
  @media (min-width: 1024px) {
    .id-photo img {
      width: 280px;
    }
  }
  .hero .role {
    margin: 0 0 var(--space-1);
  }
  .hero .availability {
    margin: 0 0 var(--space-1);
  }
</style>
