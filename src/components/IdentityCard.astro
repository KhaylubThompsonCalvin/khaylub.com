---
// The Home identity block (the first and widest block of the Home grid; the owner's requests of
// 2026-10-10): the name, the role line and the place, the availability statement with its date, the
// quick links, and the two doors, with the portrait large in the block's right column (280 px from
// 1024 px, 240 px from 640 px). On a phone the portrait (160 px) opens the block above the name,
// never between the statement and the doors, so the name, the role, the availability, and both doors
// are on the first screen at 390 by 844 and 1440 by 900. The widths cover 1x to 3x of each displayed size, up to
// the source; sizes states the displayed width exactly.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { identity, availability, monthLabel } from '@lib/profile';
import RecruiterRow from './RecruiterRow.astro';
import Doors from './Doors.astro';

interface Props {
  /** Home names the owner in its h1; About keeps "About" as the h1 and names the owner in an h2. */
  level?: 'h1' | 'h2';
}
const { level = 'h1' } = Astro.props;
const Name = level;
const id = identity();
const avail = availability();

// The portrait is a file under src/assets/profile/, named by `photo` in the profile, so the build
// derives the sized AVIF and WebP variants from one lossless source.
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile/*.{png,jpg,webp}', { eager: true });
const photo = id.photo ? portraits[`/src/assets/profile/${id.photo}`]?.default : undefined;
if (id.photo && !photo) throw new Error(`identity.yaml photo "${id.photo}" is not a file under src/assets/profile/`);
---

<section class="hero" aria-labelledby="site-name">
  <div class="id-head">
    <Name id="site-name">{id.name}</Name>
    {
      photo && (
        <span class="id-photo">
          <Picture
            src={photo}
            alt={id.photo_alt}
            widths={[160, 240, 280, 320, 480, 560, 840, 972]}
            sizes="(min-width: 1024px) 280px, (min-width: 640px) 240px, 160px"
            formats={['avif', 'webp']}
            fallbackFormat="webp"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </span>
      )
    }
  </div>
  <p class="role muted">{id.role_line} · {id.location}</p>
  <p class="availability">
    <span class="status-dot" aria-hidden="true"></span>{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small>
  </p>
  <RecruiterRow />
  <Doors />
</section>

<style is:global>
  /* On a phone the portrait comes first, then the name. */
  .id-head {
    display: grid;
    gap: var(--space-2);
    margin-bottom: var(--space-1);
  }
  .hero #site-name {
    grid-row: 2;
    font-size: clamp(1.875rem, 4vw, 3.25rem);
    margin: 0;
  }
  /* The portrait: 3 by 4, cropped on the face, rounded; centred on a phone. */
  .id-photo {
    justify-self: center;
  }
  .id-photo img {
    width: 160px;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: var(--radius-photo);
  }
  /* From 640 px the words take the first column and the portrait the second, top aligned. */
  @media (min-width: 640px) {
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr repeat(4, auto) 1fr;
      column-gap: var(--space-4);
    }
    /* The words sit in the middle rows, centred beside the portrait, which spans them all. */
    .hero .role {
      grid-row: 3;
    }
    .hero .availability {
      grid-row: 4;
    }
    .hero > nav {
      grid-row: 5;
    }
    /* The doors come right after the links; the first and last rows share what the portrait leaves. */
    .hero .doors {
      grid-row: 6;
      align-self: start;
    }
    .id-head {
      display: contents;
    }
    .hero > *,
    .hero #site-name {
      grid-column: 1;
    }
    .hero #site-name {
      grid-row: 2;
      margin-bottom: var(--space-2);
    }
    .hero .id-photo {
      grid-column: 2;
      grid-row: 1 / -1;
    }
    .id-photo img {
      width: 240px;
    }
  }
  /* On a tablet the text column is too narrow for the two doors side by side: they take the
     block's full width under the portrait. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .hero .id-photo {
      grid-row: 1 / 7;
    }
    .hero .doors {
      grid-column: 1 / -1;
      grid-row: 7;
      margin: var(--space-2) 0 0;
    }
  }
  @media (min-width: 1024px) {
    .id-photo img {
      width: 280px;
    }
  }
  .hero .role {
    margin: 0 0 var(--space-1);
  }
  .hero .availability {
    margin: 0 0 var(--space-1);
  }
  /* The status light (the convention recruiters know): green, pulsing softly, still under reduced
     motion. Green is the one colour outside the accent, a status token. */
  .status-dot {
    display: inline-block;
    width: 0.6em;
    height: 0.6em;
    margin-right: var(--space-1);
    border-radius: 50%;
    background: var(--status);
    animation: pulse 2s ease-out infinite;
  }
  @keyframes pulse {
    from {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--status) 50%, transparent);
    }
    to {
      box-shadow: 0 0 0 0.5em transparent;
    }
  }
</style>
