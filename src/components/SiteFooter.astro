---
import { identity, blogroll } from '@lib/profile';
const id = identity();
const roll = blogroll();
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container">
    <ul class="footer-links">
      <li><a href={`mailto:${id.email}`}>Email</a></li>
      <li><a href={id.github} rel="noopener noreferrer">GitHub</a></li>
      <li><a href={id.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
      <li><a href="/resume/Khaylub-Thompson-Calvin-Resume.pdf">Résumé (PDF)</a></li>
      <li><a href="/climb/">The climb</a></li>
      <li><a href="/colophon/">Colophon and accessibility</a></li>
      <li><a href="https://v1.khaylub.com" rel="noopener noreferrer">V1, the 3D experiment (2026)</a></li>
    </ul>
    {
      roll.sites.length > 0 && (
        <p class="small muted">
          Reading:{' '}
          {roll.sites.map((s, i) => (
            <>
              <a href={s.url} rel="noopener noreferrer">
                {s.name}
              </a>
              {i < roll.sites.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      )
    }
    <p class="small muted">
      {year} {id.name}. Code under the MIT license; writing and media all rights reserved unless a
      page says otherwise.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding: var(--space-4) 0;
    color: var(--muted);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
  }
  .footer-links a {
    display: inline-block;
    padding: 0.5rem 0;
    min-height: 44px;
    line-height: 1.75rem;
  }
</style>
