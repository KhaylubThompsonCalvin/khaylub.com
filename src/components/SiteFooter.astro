---
import { identity, blogroll, resumeMeta } from '@lib/profile';
const id = identity();
const roll = blogroll();
const resume = resumeMeta();
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container">
    {/* The Appearance control (F4, decision D-32): Light, Dark, or System, remembered on this device
        by src/scripts/theme.ts; System is the default and follows the device. A preference, not a
        navigation action, so it lives here and not in the header. */}
    <div class="appearance" role="group" aria-labelledby="appearance-label" data-appearance>
      <span id="appearance-label" class="small">Appearance</span>
      <div class="appearance-choices seg">
        <button type="button" aria-pressed="false" data-theme-choice="light">Light</button>
        <button type="button" aria-pressed="false" data-theme-choice="dark">Dark</button>
        <button type="button" aria-pressed="true" data-theme-choice="system">System</button>
      </div>
    </div>
    {/* The links in three named groups (the footer convention): who to reach, where to go next, and
        how this site is made. */}
    <nav class="footer-nav" aria-label="Footer">
      <div>
        <h2>Contact</h2>
        <ul class="footer-links">
          <li><a href={`mailto:${id.email}`}>Email</a></li>
          {/* rel="me" ties the profiles to this site (SEO-6). */}
          <li><a href={id.github} rel="me noopener noreferrer">GitHub</a></li>
          <li><a href={id.linkedin} rel="me noopener noreferrer">LinkedIn</a></li>
          <li><a href={resume.pdf}>Résumé (PDF)</a></li>
        </ul>
      </div>
      <div>
        <h2>Explore</h2>
        <ul class="footer-links">
          <li><a href="/library/">Library</a></li>
          <li><a href="/climb/">The climb</a></li>
          <li><a href="https://v1.khaylub.com" rel="noopener noreferrer">The climb (v1.khaylub.com)</a></li>
          <li><a href="/feed.xml">Feed (RSS)</a></li>
        </ul>
      </div>
      <div>
        <h2>This site</h2>
        <ul class="footer-links">
          <li><a href="/now/">Now</a></li>
          <li><a href="/timeline/">Timeline</a></li>
          <li><a href="/colophon/">Colophon and accessibility</a></li>
        </ul>
      </div>
    </nav>
    {
      roll.sites.length > 0 && (
        <p class="small muted">
          Reading:{' '}
          {roll.sites.map((s, i) => (
            <>
              <a href={s.url} rel="noopener noreferrer">
                {s.name}
              </a>
              {i < roll.sites.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      )
    }
    <p class="small muted">
      {year} {id.name}. Code under the MIT license; writing and media all rights reserved unless a
      page says otherwise.
    </p>
  </div>
</footer>

<style is:global>
  .appearance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-1-5);
    margin: 0 0 var(--space-3);
  }
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding: var(--space-footer) 0;
    color: var(--muted);
  }
  .footer-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: var(--space-3);
    max-width: 48rem;
    margin-bottom: var(--space-3);
  }
  .footer-nav h2 {
    font: 600 var(--size-sm) / var(--leading-body) var(--font-body);
    letter-spacing: var(--tracking-eyebrow);
    color: var(--text);
    margin: 0;
  }
  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
</style>
