---
import { identity, blogroll, resumeMeta } from '@lib/profile';
const id = identity();
const roll = blogroll();
const resume = resumeMeta();
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <div class="container">
    {/* The Appearance control (F4, decision D-32): Light, Dark, or System, remembered on this device
        by src/scripts/theme.ts; System is the default and follows the device. A preference, not a
        navigation action, so it lives here and not in the header. */}
    <div class="appearance" role="group" aria-labelledby="appearance-label" data-appearance>
      <span id="appearance-label" class="small">Appearance</span>
      <div class="appearance-choices">
        <button type="button" aria-pressed="false" data-theme-choice="light">Light</button>
        <button type="button" aria-pressed="false" data-theme-choice="dark">Dark</button>
        <button type="button" aria-pressed="true" data-theme-choice="system">System</button>
      </div>
    </div>
    <ul class="footer-links">
      <li><a href={`mailto:${id.email}`}>Email</a></li>
      {/* rel="me" ties the profiles to this site (SEO-6). */}
      <li><a href={id.github} rel="me noopener noreferrer">GitHub</a></li>
      <li><a href={id.linkedin} rel="me noopener noreferrer">LinkedIn</a></li>
      <li><a href={resume.pdf}>Résumé (PDF)</a></li>
      <li><a href="/climb/">The climb</a></li>
      <li><a href="/feed.xml">Feed (RSS)</a></li>
      <li><a href="/colophon/">Colophon and accessibility</a></li>
      <li><a href="https://v1.khaylub.com" rel="noopener noreferrer">V1, the 3D experiment (2026)</a></li>
    </ul>
    {
      roll.sites.length > 0 && (
        <p class="small muted">
          Reading:{' '}
          {roll.sites.map((s, i) => (
            <>
              <a href={s.url} rel="noopener noreferrer">
                {s.name}
              </a>
              {i < roll.sites.length - 1 ? ' · ' : ''}
            </>
          ))}
        </p>
      )
    }
    <p class="small muted">
      {year} {id.name}. Code under the MIT license; writing and media all rights reserved unless a
      page says otherwise.
    </p>
  </div>
</footer>

<style>
  .appearance {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-1-5);
    margin: 0 0 var(--space-3);
  }
  .appearance-choices {
    display: inline-flex;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }
  .appearance-choices button {
    min-height: var(--target);
    min-width: var(--target);
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text-secondary);
    font: inherit;
    font-size: var(--size-sm);
    cursor: pointer;
  }
  .appearance-choices button:hover {
    background: color-mix(in srgb, var(--ink) var(--tint-hover), transparent);
  }
  .appearance-choices button[aria-pressed='true'] {
    background: var(--interactive);
    color: var(--bg);
  }
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--line);
    padding: var(--space-4) 0;
    color: var(--muted);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-2);
  }
  .footer-links a {
    display: inline-block;
    padding: var(--space-1) 0;
    min-height: var(--target);
    line-height: 1.75rem;
  }
</style>
