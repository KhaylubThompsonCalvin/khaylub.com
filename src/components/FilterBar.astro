---
// Filters as plain links (W4): the unfiltered page is always the HTML default; the active value
// carries aria-current. No script.
import type { FilterOption } from '@lib/catalog';

interface Props {
  label: string;
  allHref: string;
  options: FilterOption[];
  /** The active value in this bar, if the page is filtered by this bar's kind. */
  active?: string;
  /** True when the page is filtered by any bar, so only the unfiltered index marks "All". */
  filtered?: boolean;
  /** How many items the unfiltered index lists; a single value carried by all of them filters nothing. */
  total?: number;
}
const { label, allHref, options, active, filtered = false, total } = Astro.props;
// A bar is left out only when it could not narrow anything: one value, carried by every item, and
// the page unfiltered. A filtered page always keeps its bars, so "All" is always a way back.
const useless = !filtered && options.length === 1 && options[0].count === total;
---

{
  options.length > 0 && !useless && (
    <nav class="filter-bar" aria-label={label}>
      <span class="filter-label small muted">{label}</span>
      <ul>
        <li>
          <a class="chip" href={allHref} aria-current={filtered ? undefined : 'page'}>
            All
          </a>
        </li>
        {options.map((o) => (
          <li>
            <a class="chip" href={o.href} aria-current={o.slug === active ? 'page' : undefined}>
              {o.label} <span class="small">{o.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style is:global>
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
    margin-bottom: var(--space-2);
  }
  .filter-bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  /* Filters are chips (the convention for a filter): the chip shape and the pressed state are the
     segmented control's, in base.css (.chip). */
</style>
