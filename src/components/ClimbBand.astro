---
// The climb's entrance (the visual redesign, vault document 65): a poster band that names the
// climb, says what it is, and offers its links. On Home it leads to the remastered climb at
// v1.khaylub.com (a plain link: nothing from that site loads here) and, below it, to the original
// June 2026 version kept on /climb/. On /climb/ it is the page's head (`standalone`) for that June
// version, with the door rendered by the page below it. Each still is served through Astro's image
// pipeline (src/assets/climb/PROVENANCE.txt). The still loads eagerly on both: the band is in the
// first viewport at 1440 by 900, so a lazy still would be the page's late LCP element.
import { Picture } from 'astro:assets';
import june from '../assets/climb/spark-wakes.webp';
import wheat from '../assets/climb/wheat-lane.webp';

interface Props {
  standalone?: boolean;
}
const { standalone = false } = Astro.props;
---

<section class:list={['climb-band', { standalone }]} aria-labelledby="climb-band-heading">
  <Picture
    src={standalone ? june : wheat}
    alt={standalone ? '' : 'A traveller with a pack walks a trodden lane through golden wheat toward a lone tree and a low sun.'}
    widths={[480, 720, 960]}
    sizes={standalone ? '(min-width: 1200px) 1104px, 100vw' : '(min-width: 1024px) 560px, 100vw'}
    formats={['avif', 'webp']}
    fallbackFormat="webp"
    loading="eager"
    fetchpriority="low"
    decoding="async"
    class="climb-still"
  />
  <div class="climb-words">
    {
      standalone ? (
        <div>
          <h1 id="climb-band-heading">The climb</h1>
          <p class="climb-what">
            The original interactive version of this site: one scroll from night into day, a Wanderer, and a
            Phoenix. The June 2026 release, kept as it shipped.
          </p>
          <p class="climb-line small">Optional. About 7 MB loads only when you enter; nothing of it loads on this page.</p>
        </div>
      ) : (
        <>
          <div>
            <h2 id="climb-band-heading">The climb</h2>
            <p class="climb-what">
              One scroll through six climates and times of day, from a desert night to golden wheat, with the
              Wanderer and the Phoenix.
            </p>
            <p class="climb-line small">
              Opens v1.khaylub.com. About 0.8 MB before the first picture; each scene loads as you near it.
            </p>
          </div>
          <p class="climb-go">
            <a class="btn btn-on-image" href="https://v1.khaylub.com/" rel="noopener noreferrer">Enter the climb</a>
            <a class="small" href="/climb/">The original June 2026 version</a>
          </p>
        </>
      )
    }
  </div>
</section>
