---
import PrimaryNav from './PrimaryNav.astro';
import { identity } from '@lib/profile';

interface Props {
  current?: string;
}
const { current } = Astro.props;
const id = identity();
---

<header class="site-header" id="site-header">
  <div class="container navbar">
    <a class="brand" href="/" aria-current={current === 'home' ? 'page' : undefined}>{id.name}</a>
    <PrimaryNav current={current} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: transform var(--ease);
  }
  /* On a long page the header steps away while reading down and returns on any scroll up
     (header-scroll.ts); never while the menu is open or the header has focus. */
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-height);
  }
  .brand {
    font-family: var(--font-display);
    font-size: var(--size-brand);
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: var(--target);
    line-height: 1.2;
    min-width: 0;
    flex: 1 1 auto;
    /* The name wraps rather than truncates: no content is lost at any width or text spacing
       (WCAG 1.4.12); at 390 px it still fits on one line. */
    overflow-wrap: anywhere;
  }
  .navbar > :global(nav) {
    flex: 0 0 auto;
  }
</style>
