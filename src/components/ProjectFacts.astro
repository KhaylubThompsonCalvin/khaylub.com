---
// Context (a school or academic project's course, term, or institution line; ADR-012), outcome,
// technologies, and proof links for a project or data entry, from frontmatter only.
// Used inside featured cards (compact) and in the artifact page header.
import { evidenceFor, labelFor, termRoute, type AnyEntry } from '@lib/catalog';

interface Props {
  entry: AnyEntry;
  compact?: boolean;
}
const { entry, compact = false } = Astro.props;
const data = entry.data as Record<string, any>;
const techSlugs: string[] = data.technologies ?? [];
const withPage = new Set((await evidenceFor('technologies')).map((t) => t.slug));
const tech = techSlugs.map((s) => ({ slug: s, label: labelFor('technologies', s), href: withPage.has(s) ? termRoute('technologies', s) : undefined }));
const links: { label: string; href: string }[] = [];
if (entry.collection === 'projects') {
  if (data.links?.code) links.push({ label: 'Code', href: data.links.code });
  if (data.links?.live) links.push({ label: 'Live', href: data.links.live });
  if (data.links?.result) links.push({ label: 'Result', href: data.links.result });
}
if (entry.collection === 'data') {
  if (data.repository) links.push({ label: 'Repository', href: data.repository });
  if (data.links?.result) links.push({ label: 'Result', href: data.links.result });
  if (data.story_url) links.push({ label: 'Story', href: data.story_url });
}
// On a card a data entry's result stands in for the outcome; on its own page the facts list carries it.
const outcome: string | undefined = data.outcome ?? (compact && entry.collection === 'data' ? data.result : undefined);
// The course, term, or institution line of a school or academic project (projects only).
const context: string | undefined = entry.collection === 'projects' ? data.context : undefined;
---

<div class:list={['facts', { compact }]}>
  {context && <p class="context small muted"><span class="visually-hidden">Context: </span>{context}</p>}
  {outcome && <p class="outcome">{outcome}</p>}
  {
    tech.length > 0 && (
      <p class="tech small muted">
        Built with{' '}
        {tech.map((t, i) => (
          <>
            {t.href ? <a href={t.href}>{t.label}</a> : t.label}
            {i < tech.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
    )
  }
  {
    links.length > 0 && (
      <p class="proof">
        {links.map((l) => (
          <a class:list={['btn', { 'btn-small': compact }]} href={l.href} rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>
            {l.label}
            <span class="visually-hidden"> for {entry.data.title}</span>
          </a>
        ))}
      </p>
    )
  }
</div>

<style>
  .facts {
    display: grid;
    gap: var(--space-1);
  }
  .context {
    margin: 0;
  }
  .outcome {
    font-weight: 600;
    margin: 0;
  }
  .tech {
    margin: 0;
  }
  /* Proof links stay clickable above the card's full-surface title link (its ::after overlay). */
  /* The card's whole-surface link sits under the facts; the technology links must stay clickable. */
  .tech {
    position: relative;
    z-index: 1;
  }
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-2);
    margin: 0;
    position: relative;
    z-index: 1;
  }
  .btn-small {
    padding: 0.5rem 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
  }
</style>
