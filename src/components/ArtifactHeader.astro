---
// The header block every artifact page shares: title, status badge, dates, the AI-assistance
// sentence when declared, the facts (outcome, technologies, proof links), and the data facts list.
import Badge from './Badge.astro';
import ProjectFacts from './ProjectFacts.astro';
import { badgeFor, collectionLabel, seriesLabel, type AnyEntry } from '@lib/catalog';
import { prevNext } from '@lib/graph';

interface Props {
  entry: AnyEntry;
}
const { entry } = Astro.props;
const data = entry.data as Record<string, any>;
const badge = badgeFor(entry);
const date = data.date.toISOString().slice(0, 10);
const isData = entry.collection === 'data';
const seq = await prevNext(data.slug);
const seriesRoute = entry.collection === 'notes' && seq.series ? `/notes/series/${seq.series.name}/` : undefined;
---

<header class="artifact-header measure-reading">
  <h1>{data.title}</h1>
  <p class="meta">
    <Badge text={badge.text} tone={badge.tone} />
    <span class="muted">{collectionLabel(entry.collection)} · <time datetime={date} data-pagefind-meta="date">{date}</time>{data.updated ? `, updated ${data.updated.toISOString().slice(0, 10)}` : ''}</span>
  </p>
  {
    seq.series && (
      <p class="series-line small muted">
        Part {seq.series.part} of {seq.series.total} in the series {seriesRoute ? <a href={seriesRoute}>{seriesLabel(seq.series.name)}</a> : seriesLabel(seq.series.name)}
      </p>
    )
  }
  {data.ai_assisted && <p class="muted small">Built with AI assistance in the code; the design, decisions, and testing are the author's.</p>}
  {
    (data.problem || data.role) && (
      <dl class="summary-card">
        {data.problem && (
          <>
            <dt>Problem</dt>
            <dd class="problem">{data.problem}</dd>
          </>
        )}
        {data.role && (
          <>
            <dt>My role</dt>
            <dd class="role">{data.role}</dd>
          </>
        )}
      </dl>
    )
  }
  <ProjectFacts entry={entry} />
  {
    isData && (
      <dl class="facts">
        <dt>Question</dt>
        <dd>{data.question}</dd>
        <dt>Data</dt>
        <dd>{data.dataset.name}. Source: {data.dataset.source}. License: {data.dataset.license}.</dd>
        <dt>Result</dt>
        <dd>{data.result}</dd>
      </dl>
    )
  }
</header>

<style>
  /* The title block keeps a gap of its own before the body (F5): the last line's margin is not it. */
  .artifact-header {
    margin-bottom: var(--space-header-body);
  }
  .artifact-header > :last-child {
    margin-bottom: 0;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  .summary-card {
    margin: 0 0 var(--space-2);
    padding: var(--space-2);
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .summary-card dt {
    font-weight: 600;
  }
  .summary-card dd {
    margin: 0 0 var(--space-1);
  }
  .summary-card dd:last-child {
    margin-bottom: 0;
  }
  .facts dt {
    font-weight: 600;
    margin-top: var(--space-1);
  }
  .facts dd {
    margin: 0;
  }
</style>
