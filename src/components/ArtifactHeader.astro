---
// The header block every artifact page shares: title, status badge, dates, the AI-assistance
// sentence when declared, the facts (outcome, technologies, proof links), and the data facts list.
import Badge from './Badge.astro';
import ProjectFacts from './ProjectFacts.astro';
import { badgeFor, collectionLabel, type AnyEntry } from '@lib/catalog';

interface Props {
  entry: AnyEntry;
}
const { entry } = Astro.props;
const data = entry.data as Record<string, any>;
const badge = badgeFor(entry);
const date = data.date.toISOString().slice(0, 10);
const isData = entry.collection === 'data';
---

<header class="artifact-header measure-reading">
  <h1>{data.title}</h1>
  <p class="meta">
    <Badge text={badge.text} tone={badge.tone} />
    <span class="muted">{collectionLabel(entry.collection)} · <time datetime={date} data-pagefind-meta="date">{date}</time>{data.updated ? `, updated ${data.updated.toISOString().slice(0, 10)}` : ''}</span>
  </p>
  {data.ai_assisted && <p class="muted small">Built with AI assistance in the code; the design, decisions, and testing are the author's.</p>}
  <ProjectFacts entry={entry} />
  {
    isData && (
      <dl class="facts">
        <dt>Question</dt>
        <dd>{data.question}</dd>
        <dt>Data</dt>
        <dd>{data.dataset.name}. Source: {data.dataset.source}. License: {data.dataset.license}.</dd>
        <dt>Result</dt>
        <dd>{data.result}</dd>
      </dl>
    )
  }
</header>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-2);
  }
  .facts dt {
    font-weight: 600;
    margin-top: var(--space-1);
  }
  .facts dd {
    margin: 0;
  }
</style>
