---
// A calling card (the 2026-10-10 polish): what stands in the picture's place when an entry has no
// picture of its own, never an empty frame. The kind's icon, the title large in the display face,
// one fact of the entry's own (a technology, a date), on a sienna-edged tint of the surface. It
// repeats the title beside it, so it is hidden from assistive technology.
interface Props {
  title: string;
  kind: string;
  fact?: string;
  class?: string;
}
const { title, kind, fact, class: cls } = Astro.props;
// Simple line icons, one per kind: a folder (project), bars (data), a page (note, writing, journal),
// a play mark (video), a frame (gallery), a flask (experiment), a note (music).
const ICONS: Record<string, string> = {
  projects: 'M2 5h5l2 2h7v8H2z',
  data: 'M3 15V9M8 15V4M13 15v-7M2 16h14',
  notes: 'M4 2h7l3 3v11H4zM7 8h5M7 11h5',
  writing: 'M4 2h7l3 3v11H4zM7 8h5M7 11h5',
  journal: 'M4 2h7l3 3v11H4zM7 8h5M7 11h5',
  video: 'M3 3h12v12H3zM7 6l5 3-5 3z',
  gallery: 'M2 3h14v12H2zM2 12l4-4 4 4 2-2 4 4',
  experiments: 'M7 2h4M8 2v5l-5 8h12l-5-8V2',
  music: 'M7 14V3l8-1v10M7 14a2 2 0 1 1-4 0 2 2 0 0 1 4 0zM15 12a2 2 0 1 1-4 0 2 2 0 0 1 4 0z',
};
---

<div class:list={['call', cls]} aria-hidden="true">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d={ICONS[kind] ?? ICONS.notes} /></svg>
  <b>{title}</b>
  {fact && <small>{fact}</small>}
</div>
