---
import { now, monthLabel } from '@lib/profile';
const n = now();
---

<section class="section" aria-labelledby="now-heading">
  <h2 id="now-heading" class="section-heading">Now <span class="as-of">as of {monthLabel(n.as_of)}</span></h2>
  <p class="callout">
    {n.lines.join(' ')}
    <a href="/now/">More on the Now page</a>.
  </p>
</section>
