---
// Contents nav for long artifact pages (W5 sidebar from 1024 px, in flow below). Rendered only
// when the body has at least five H2 headings, the smallest case-study page today; shorter notes
// read top to bottom without one.
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
export const TOC_MIN_HEADINGS = 5;
const items = Astro.props.headings.filter((h) => h.depth === 2);
---

{
  items.length >= TOC_MIN_HEADINGS && (
    <nav class="toc" aria-label="Contents">
      <p class="toc-title">Contents</p>
      <ol>
        {items.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  /* The contents (the redesign's evidence room): a head on an ink rule and a plain list with a quiet
     rule under each entry, like the fact tables above it. No card, no capitals. */
  .toc {
    margin: 0 0 var(--space-3);
    border-top: 2px solid var(--ink);
    padding-top: var(--space-1);
  }
  .toc-title {
    margin: 0 0 var(--space-half);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc li {
    border-bottom: 1px solid var(--border);
  }
  .toc a {
    display: inline-block;
    padding: var(--space-half) 0;
    min-height: var(--target-min);
  }
  @media (min-width: 1024px) {
    .toc {
      position: sticky;
      top: calc(var(--header-height) + var(--space-2));
    }
  }
</style>
