---
// The withdrawal notice (Phase 27, runbook 10.9): what a withdrawn artifact's address serves. The
// host keeps serving a page that a later deploy merely omits, so the build writes this page at the
// same path instead; it names nothing from the piece (no title, summary, media, or record), tells
// search engines not to index it, and points at the collection. Nothing here is a design surface.
import type { ArtifactCollection } from '@lib/catalog';
import { COLLECTIONS } from '@lib/catalog';

interface Props {
  collection: ArtifactCollection;
}
const { collection } = Astro.props;
const meta = COLLECTIONS.find((c) => c.name === collection)!;
---

<section class="withdrawn measure-reading" data-withdrawn="true">
  <h1>This piece has been withdrawn</h1>
  <p>It is no longer available on this site.</p>
  <p><a href={meta.route}>Back to {meta.label}</a></p>
</section>

<style>
  .withdrawn {
    padding-block: var(--space-4);
  }
</style>
