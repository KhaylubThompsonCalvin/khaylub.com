---
// Khaylub's Top 8: eight things ranked and dated, as a set of captioned tiles (the design
// initiative's F5, vault document 65: the profile-page grammar, set like a publication). Each tile
// carries its rank, its title in the display face, and, under the tile, the owner's one-line reason
// with the kind and the date. An entry's picture fills its tile under the scrim: its cover, or for an
// entry with no cover a picture it already shows (PICTURES); a tile with no picture at all is a
// typographic tile on the tint, never an empty frame.
import { getImage } from 'astro:assets';
import { top8Entries, badgeFor, routeFor } from '@lib/catalog';
import type { top8Revisions } from '@lib/profile';
import { coverThumb, type Thumb } from '@lib/media';
import wheat from '../assets/climb/wheat-lane.webp';

const wheatThumb = await getImage({ src: wheat, width: 640, format: 'webp', quality: 70 });
// The pictures already published for entries without a cover: the climb's golden-wheat still (the
// home band's picture) and the charts on the two data case studies, whose pale charts are dimmed on
// the scrim (`pale`) so the rank and title keep their contrast. Decorative beside the title.
const PALE = new Set(['fuel-economy-regression', 'sql-python-analytics-pipeline']);
const PICTURES: Record<string, Thumb> = {
  'khaylub-com-v1': { src: wheatThumb.src, alt: '', width: Number(wheatThumb.attributes.width), height: Number(wheatThumb.attributes.height) },
  'fuel-economy-regression': { src: '/media/fuel-economy-regression/residuals.webp', alt: '', width: 1200, height: 462 },
  'sql-python-analytics-pipeline': { src: '/media/sql-python-analytics-pipeline/names-trend-chart.webp', alt: '', width: 1200, height: 655 },
};

interface Props {
  /** An archived revision; the newest revision when omitted. */
  revision?: ReturnType<typeof top8Revisions>[number];
  /** On the Top 8 pages the page's H1 names the set, so the module draws no heading and the tile
      titles are the page's H2s (one title, no skipped level). Home and the Library keep the head. */
  titled?: boolean;
}
const { revision, titled = false } = Astro.props;
const TileHeading = titled ? 'h2' : 'h3';
const { asOf, entries, skipped } = await top8Entries(revision);
const label = new Date(`${asOf}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
// The kind is what the thing is (a project, data work, a Field Note, a gallery piece); the status of
// a project (Live, Private beta) is a separate word in the caption, never the kind. "Published" is
// not shown: every tile is published.
const KINDS: Record<string, string> = { projects: 'Project', data: 'Data', notes: 'Field Note', writing: 'Writing', journal: 'Journal', music: 'Music', video: 'Video', gallery: 'Gallery', experiments: 'Experiment' };
const tiles = await Promise.all(
  entries.map(async ({ entry, reason }, i) => {
    const badge = badgeFor(entry);
    const status = entry.collection === 'projects' && badge.text !== 'Published' ? badge.text : undefined;
    const cover = (await coverThumb(entry)) ?? PICTURES[entry.data.slug];
    return { entry, reason, rank: i + 1, kind: KINDS[entry.collection] ?? entry.collection, status, live: badge.tone === 'live', cover, date: entry.data.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) };
  })
);
// A set of seven (or any count that leaves a gap in the last row) is laid out on purpose: the
// first-ranked tile takes the spare columns as a wide tile, so no row implies a missing card.
// Four across from 700 px, two across from 360 px; an eighth item returns the grid to squares.
const spare4 = (4 - (tiles.length % 4)) % 4;
const spare2 = tiles.length % 2;
---

<section class="section" aria-labelledby={titled ? undefined : 'top8-heading'}>
  {!titled && <h2 id="top8-heading" class="section-heading module-heading">Khaylub's Top 8 <span class="as-of">as of {label}</span></h2>}
  {
    tiles.length > 0 ? (
      <ol class="top8" data-spare4={spare4 || undefined} data-spare2={spare2 || undefined}>
        {tiles.map((t) => (
          <li>
            <article class:list={['tile', t.cover ? 'has-cover' : 'type-tile', { pale: PALE.has(t.entry.data.slug) }]}>
              <div class="tile-art">
                {t.cover && <img src={t.cover.src} alt="" loading="lazy" decoding="async" width={t.cover.width} height={t.cover.height} />}
                <span class="tile-rank" aria-hidden="true">{String(t.rank).padStart(2, '0')}</span>
                <span class="tile-kind">{t.kind}</span>
                <TileHeading>
                  <span class="visually-hidden">Rank {t.rank}. </span>
                  <a href={routeFor(t.entry)}>{t.entry.data.title}</a>
                </TileHeading>
              </div>
              <p class="tile-cap">
                {t.reason}{' '}
                <span class="tile-meta">
                  {t.status && <span class:list={{ signal: t.live }}>{t.status} · </span>}
                  {t.date}
                </span>
              </p>
            </article>
          </li>
        ))}
      </ol>
    ) : (
      <p class="muted">The first Top 8 is being chosen.</p>
    )
  }
  <p class="small muted top8-note">
    {revision ? 'Eight things I was proud of then, ranked and dated.' : 'Eight things I am proud of right now, ranked and dated.'} <a href="/top8/">{revision ? 'The current set' : 'Previous sets'}</a>.{skipped > 0 ? ` ${skipped} ${skipped === 1 ? 'slot is' : 'slots are'} not published yet and will appear when they are.` : ''}
  </p>
</section>

<style>
  .top8-note {
    margin-top: var(--space-3);
  }
</style>
