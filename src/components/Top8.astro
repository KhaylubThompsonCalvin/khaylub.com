---
// Khaylub's Top 8: eight things ranked and dated, as a set of captioned tiles (the design
// initiative's F5, vault document 65: the profile-page grammar, set like a publication). Each tile
// carries its rank, its title in the display face, and, under the tile, the owner's one-line reason
// with the kind and the date. An entry's picture fills its tile under the scrim: its cover, or for an
// entry with no cover a picture it already shows (PICTURES); a tile with no picture at all is a
// typographic tile on the tint, never an empty frame.
import { getImage } from 'astro:assets';
import { top8Entries, top8For, badgeFor, routeFor, type AnyEntry } from '@lib/catalog';
import { AUDIENCES, type top8Revisions } from '@lib/profile';
import { pictureFor, type Thumb } from '@lib/media';
import wheat from '../assets/climb/wheat-lane.webp';

const wheatThumb = await getImage({ src: wheat, width: 640, format: 'webp', quality: 70 });
// The tile's picture comes from pictureFor (the entry's cover, else the first picture its body
// publishes, a pale chart dimmed on the scrim so the rank and title keep their contrast); the first
// climb keeps the Home band's golden-wheat still. Decorative beside the title.
const PICTURES: Record<string, Thumb> = {
  'khaylub-com-v1': {
    src: wheatThumb.src,
    alt: '',
    width: Number(wheatThumb.attributes.width),
    height: Number(wheatThumb.attributes.height),
  },
};

interface Props {
  /** An archived revision; the newest revision when omitted. */
  revision?: ReturnType<typeof top8Revisions>[number];
  /** On the Top 8 pages the page's H1 names the set, so the module draws no heading and the tile
      titles are the page's H2s (one title, no skipped level). Home and the Library keep the head. */
  titled?: boolean;
  /** Home (Profile Themes, 2026-10-10): the site Top 8 as the default list, then one ranked, dated
      list per audience (content/profile/audiences.yaml, without reasons), each with data-for, so a
      stored audience shows its own list and its own date before first paint. */
  audiences?: boolean;
}
const { revision, titled = false, audiences = false } = Astro.props;
const TileHeading = titled ? 'h2' : 'h3';
const { asOf, entries, skipped } = await top8Entries(revision);
const monthYear = (ym: string) =>
  new Date(`${ym}-01T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
const label = monthYear(asOf);
// The kind is what the thing is (a project, data work, a Field Note, a gallery piece); the status of
// a project (Live, Private beta) is a separate word in the caption, never the kind. "Published" is
// not shown: every tile is published.
const KINDS: Record<string, string> = {
  projects: 'Project',
  data: 'Data',
  notes: 'Field Note',
  writing: 'Writing',
  journal: 'Journal',
  music: 'Music',
  video: 'Video',
  gallery: 'Gallery',
  experiments: 'Exhibit',
};
const tilesOf = (list: { entry: AnyEntry; reason: string }[]) =>
  Promise.all(
    list.map(async ({ entry, reason }, i) => {
      const badge = badgeFor(entry);
      const status =
        entry.collection === 'projects' && badge.text !== 'Published' ? badge.text : undefined;
      const cover = PICTURES[entry.data.slug] ?? (await pictureFor(entry));
      return {
        entry,
        reason,
        rank: i + 1,
        kind: KINDS[entry.collection] ?? entry.collection,
        status,
        live: badge.tone === 'live',
        cover,
        date: entry.data.date.toLocaleDateString('en-US', {
          month: 'short',
          year: 'numeric',
          timeZone: 'UTC',
        }),
      };
    })
  );
// A set of seven (or any count that leaves a gap in the last row) is laid out on purpose: the
// first-ranked tile takes the spare columns as a wide tile, so no row implies a missing card.
// Four across from 900 px, two across from 360 px; an eighth item returns the grid to squares.
const lists = [{ id: 'default', label, tiles: await tilesOf(entries) }];
if (audiences)
  for (const a of AUDIENCES) {
    const t = await top8For(a);
    lists.push({ id: a, label: monthYear(t.asOf), tiles: await tilesOf(t.entries) });
  }
const spare = (n: number) => ({ spare4: (4 - (n % 4)) % 4, spare2: n % 2 });
const forId = (id: string) => (audiences ? id : undefined);
---

<section class="section" aria-labelledby={titled ? undefined : 'top8-heading'}>
  {
    !titled && (
      <h2 id="top8-heading" class="section-heading module-heading">
        Khaylub's Top 8{' '}
        {lists.map((l) => (
          <span class="as-of" data-for={forId(l.id)}>
            as of {l.label}
          </span>
        ))}
      </h2>
    )
  }
  {
    lists.map((l) =>
      l.tiles.length > 0 ? (
        <ol
          class="top8"
          data-for={forId(l.id)}
          data-spare4={spare(l.tiles.length).spare4 || undefined}
          data-spare2={spare(l.tiles.length).spare2 || undefined}
        >
          {l.tiles.map((t) => (
            <li>
              <article
                class:list={[
                  'tile',
                  t.cover ? 'has-cover' : 'type-tile',
                  { pale: (t.cover as { pale?: boolean } | undefined)?.pale },
                ]}
              >
                <div class="tile-art">
                  {t.cover && (
                    <img
                      src={t.cover.src}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width={t.cover.width}
                      height={t.cover.height}
                    />
                  )}
                  <span class="tile-rank" aria-hidden="true">
                    {String(t.rank).padStart(2, '0')}
                  </span>
                  <span class="tile-kind">{t.kind}</span>
                  <TileHeading>
                    <span class="visually-hidden">Rank {t.rank}. </span>
                    <a href={routeFor(t.entry)}>{t.entry.data.title}</a>
                  </TileHeading>
                </div>
                <p class="tile-cap">
                  {t.reason && `${t.reason} `}
                  <span class="tile-meta">
                    {t.status && <span class:list={{ signal: t.live }}>{t.status} · </span>}
                    {t.date}
                  </span>
                </p>
              </article>
            </li>
          ))}
        </ol>
      ) : (
        <p class="muted" data-for={forId(l.id)}>
          The first Top 8 is being chosen.
        </p>
      )
    )
  }
  <p class="small muted top8-note">
    {
      revision
        ? 'Eight things I was proud of then, ranked and dated.'
        : 'Eight things I am proud of right now, ranked and dated.'
    }
    {' '}<a href="/top8/">{revision ? 'The current set' : 'Previous sets'}</a>.{
      skipped > 0 ? (
        <span
          data-for={forId('default')}
        >{` ${skipped} ${skipped === 1 ? 'slot is' : 'slots are'} not published yet and will appear when they are.`}</span>
      ) : (
        ''
      )
    }
  </p>
</section>

<style is:global>
  .top8-note {
    margin-top: var(--space-3);
  }
</style>
