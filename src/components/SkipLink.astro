---
// The first focusable element on every page (WCAG 2.4.1). Visible on focus only.
---

<a class="skip-link" href="#main">Skip to main content</a>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: var(--space-1);
    z-index: 200;
    padding: var(--space-1) var(--space-1-5);
    background: var(--card);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: var(--radius-sm);
    text-decoration: none;
    font-weight: 600;
  }
  .skip-link:focus {
    left: var(--space-1);
  }
</style>
