---
// The first focusable element on every page (WCAG 2.4.1). Visible on focus only.
---

<a class="skip-link" href="#main">Skip to main content</a>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    z-index: 200;
    padding: 0.5rem 0.75rem;
    background: var(--card);
    color: var(--ink);
    border: 2px solid var(--ink);
    border-radius: 6px;
    text-decoration: none;
    font-weight: 600;
  }
  .skip-link:focus {
    left: 0.5rem;
  }
</style>
