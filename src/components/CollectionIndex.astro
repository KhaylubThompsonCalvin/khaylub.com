---
// The listing template every collection route uses (doc 31: IndexLayout plus CardGrid).
// Breadcrumb, heading, intro, count, filters as links, sort links, the card grid, the feed link.
import Breadcrumb from './Breadcrumb.astro';
import FilterBar from './FilterBar.astro';
import ArtifactCard from './ArtifactCard.astro';
import { SORT_ORDERS, filterOptions, sortEntries, type AnyEntry, type ArtifactCollection, type SortOrder } from '@lib/catalog';
import { openingLine } from '@lib/excerpt';

interface Props {
  meta: { name: ArtifactCollection; label: string; route: string; description: string };
  /** Every visible entry of the collection (filters are counted from this set). */
  all: AnyEntry[];
  /** The entries this page shows (a subset of `all` when filtered). */
  entries: AnyEntry[];
  sort?: SortOrder;
  filter?: { kind: 'tag' | 'type' | 'series'; slug: string; label: string };
}
const { meta, all, entries, sort = 'newest', filter } = Astro.props;
const shown = sortEntries(entries, sort);
const options = filterOptions(meta.name, all);
const trail = [{ name: 'Home', path: '/' }, { name: 'Library', path: '/library/' }, { name: meta.label, path: meta.route }];
if (filter) trail.push({ name: filter.label, path: Astro.url.pathname });
const sortHref = (order: SortOrder) => (order === 'newest' ? meta.route : `${meta.route}sort/${order}/`);
---

<Breadcrumb trail={trail} />
{/* The room's plate (the visual redesign): Writing reads as the reading room, the others as the archive. */}
<div class:list={['plate', 'page-intro', meta.name === 'writing' ? 'room-writing' : 'room-library']}>
  <h1>{filter ? `${meta.label}: ${filter.label}` : meta.label}</h1>
  <p class="lead measure">{meta.description}</p>
  {/* The room's counts describe the whole collection; a filtered page states its own count below. */}
  {
    !filter && (
      <ul class="counts">
        <li><b>{all.length}</b> published {all.length === 1 ? 'item' : 'items'}</li>
        {options.types.length > 1 && <li><b>{options.types.length}</b> {meta.name === 'projects' ? 'statuses' : 'types'}</li>}
        {options.tags.length > 1 && <li><b>{options.tags.length}</b> tags</li>}
      </ul>
    )
  }
</div>

<section class="section" aria-labelledby="list-heading">
  <h2 id="list-heading" class:list={{ 'list-count': true }}>
    {shown.length} {shown.length === 1 ? 'item' : 'items'}{filter ? ` with ${filter.kind === 'type' ? (meta.name === 'projects' ? 'status' : 'type') : filter.kind} ${filter.label}` : ''}
  </h2>

  <FilterBar label="Filter by type" allHref={meta.route} options={options.types} active={filter?.kind === 'type' ? filter.slug : undefined} filtered={!!filter} total={all.length} />
  <FilterBar label="Filter by tag" allHref={meta.route} options={options.tags} active={filter?.kind === 'tag' ? filter.slug : undefined} filtered={!!filter} total={all.length} />
  <FilterBar label="Filter by series" allHref={meta.route} options={options.series} active={filter?.kind === 'series' ? filter.slug : undefined} filtered={!!filter} total={all.length} />

  {
    !filter && shown.length > 1 && (
      <p class="sort-links small">
        Sort:{' '}
        {SORT_ORDERS.map((s, i) => (
          <>
            <a href={sortHref(s.order)} aria-current={s.order === sort ? 'page' : undefined}>
              {s.label}
            </a>
            {i < SORT_ORDERS.length - 1 ? ' · ' : ''}
          </>
        ))}
      </p>
    )
  }

  {
    shown.length > 0 ? (
      <ul class="card-grid list">
        {shown.map((e, i) => (
          <li>
            <ArtifactCard entry={e}>
              {/* The reading room features its newest piece with a line of its own words. */}
              {meta.name === 'writing' && i === 0 && !filter && sort === 'newest' && openingLine(e.body) && <p class="pull-quote">{openingLine(e.body)}</p>}
            </ArtifactCard>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Nothing published in this collection yet.</p>
    )
  }
  <p class="small muted feed-link">
    <a href={`${meta.route}feed.xml`}>RSS feed for {meta.label}</a>
  </p>
</section>

<style>
  /* The count is a working line, not a second title: the working face at the h3 size. */
  .list-count {
    font-family: var(--font-body);
    font-size: var(--size-h3);
    font-weight: 600;
  }
  .sort-links a[aria-current='page'] {
    font-weight: 600;
    text-decoration: none;
  }
  .sort-links a {
    display: inline-block;
    padding: var(--space-1) 0;
  }
  .feed-link {
    margin-top: var(--space-2);
  }
</style>
