---
// The timeline body: a filter bar of group links, then years as sections with a plain list.
// The vertical rule is CSS on the list; the HTML is only the list (W11).
import FilterBar from './FilterBar.astro';
import { TIMELINE_GROUPS, type TimelineGroup, type TimelineRow } from '@lib/catalog';

interface Props {
  rows: TimelineRow[];
  all: TimelineRow[];
  group?: TimelineGroup;
}
const { rows, all, group } = Astro.props;
const options = TIMELINE_GROUPS.map((g) => ({ slug: g.slug, label: g.label, count: all.filter((r) => r.group === g.slug).length, href: `/timeline/${g.slug}/` })).filter((o) => o.count > 0);
const years = [...new Set(rows.map((r) => r.date.getUTCFullYear()))];
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<FilterBar label="Show" allHref="/timeline/" options={options} active={group} filtered={!!group} />
{
  years.map((y) => (
    <section aria-labelledby={`year-${y}`}>
      <h2 id={`year-${y}`}>{y}</h2>
      <ul class="events">
        {rows
          .filter((r) => r.date.getUTCFullYear() === y)
          .map((r) => (
            <li>
              <time datetime={iso(r.date)}>{iso(r.date)}</time>{' '}
              {r.url ? <a href={r.url}>{r.title}</a> : r.title} <span class="small muted">{r.kind}</span>
            </li>
          ))}
      </ul>
    </section>
  ))
}

<style>
  .events {
    list-style: none;
    padding: 0 0 0 var(--space-2);
    border-left: 2px solid var(--line);
  }
  .events li {
    padding: var(--space-1) 0;
    border-bottom: 1px solid var(--line);
  }
  time {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    margin-right: var(--space-1);
  }
</style>
