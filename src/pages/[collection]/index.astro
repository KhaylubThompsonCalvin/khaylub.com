---
// The unfiltered, newest-first index of every collection. Filters and sorts are sibling routes.
import BaseLayout from '@layouts/BaseLayout.astro';
import CollectionIndex from '@components/CollectionIndex.astro';
import { COLLECTIONS, published } from '@lib/catalog';

export function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { collection: c.name }, props: { meta: c } }));
}

const { meta } = Astro.props;
const entries = await published(meta.name);
---

<BaseLayout title={meta.label} description={`${meta.label}: ${meta.description}`} current={meta.name} feed={{ href: `${meta.route}feed.xml`, title: `${meta.label} feed` }}>
  <CollectionIndex meta={meta} all={entries} entries={entries} />
</BaseLayout>
