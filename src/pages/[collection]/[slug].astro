---
// One artifact template for every collection (doc 31: ArticleLayout). Breadcrumb, the shared
// header (badge, dates, facts, proof links), a contents nav on long pages, the body, and a footer
// with the source, the related rail, backlinks, previous and next, and the skill and tag labels
// (Phase 14: ADR-006, W15).
import { render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumb from '@components/Breadcrumb.astro';
import ArtifactHeader from '@components/ArtifactHeader.astro';
import MediaBlock from '@components/media/MediaBlock.astro';
import Credits from '@components/Credits.astro';
import Withdrawn from '@components/Withdrawn.astro';
import RelatedRail from '@components/relations/RelatedRail.astro';
import Backlinks from '@components/relations/Backlinks.astro';
import PrevNext from '@components/relations/PrevNext.astro';
import { mediaForJsonLd } from '@lib/media';
import { ogAlt } from '@lib/og';
import { identity } from '@lib/profile';
import TableOfContents, { TOC_MIN_HEADINGS } from '@components/TableOfContents.astro';
import { COLLECTIONS, allVisible, allWithdrawn, collectionLabel, evidenceFor, labelFor, routeFor, type AnyEntry } from '@lib/catalog';
import { creativeWork, breadcrumbs } from '@lib/seo';

export async function getStaticPaths() {
  const entries = await allVisible();
  // A withdrawn piece keeps its address with a notice in place of the page (Phase 27, runbook 10.9).
  const withdrawn = await allWithdrawn();
  return [
    ...entries.map((entry) => ({ params: { collection: entry.collection, slug: entry.data.slug }, props: { entry, withdrawn: false } })),
    ...withdrawn.map((entry) => ({ params: { collection: entry.collection, slug: entry.data.slug }, props: { entry, withdrawn: true } })),
  ];
}

const { entry, withdrawn } = Astro.props as { entry: AnyEntry; withdrawn: boolean };
const data = entry.data as any;
const path = routeFor(entry);
const meta = COLLECTIONS.find((c) => c.name === entry.collection)!;
const { Content, headings } = withdrawn ? { Content: null as any, headings: [] as { depth: number; slug: string; text: string }[] } : await render(entry as any);
// Only skills with a public evidence row get a link; a skill shown solely by this item while it is
// archived, employer-hidden, or a preview draft is named without one.
const evidenced = new Set((await evidenceFor('skills')).map((s) => s.slug));
const trail = [
  { name: 'Home', path: '/' },
  { name: meta.label, path: meta.route },
  { name: data.title, path },
];
const jsonLd = [creativeWork(entry, path, await mediaForJsonLd(entry)), breadcrumbs(trail)];
// The artifact's own Open Graph card (SEO-3), built by src/pages/og/[collection]/[slug].png.ts.
const ogImage = `/og/${entry.collection}/${data.slug}.png`;
const ogImageAlt = ogAlt(entry, meta.label, identity().site_name);
---

{
  withdrawn ? (
    <BaseLayout title={`Withdrawn: ${data.slug}`} description="This piece has been withdrawn from the site and is no longer available at this address." current={entry.collection} noindex>
      <Withdrawn collection={entry.collection} />
    </BaseLayout>
  ) : (
<BaseLayout title={data.title} description={data.summary} current={entry.collection} jsonLd={jsonLd} ogImage={ogImage} ogImageAlt={ogImageAlt} ogType="article" feed={{ href: `${meta.route}feed.xml`, title: `${meta.label} feed` }}>
  <article class="artifact" data-pagefind-body={data.status === 'published' ? '' : undefined} data-pagefind-meta={`collection:${collectionLabel(entry.collection)}`}>
    <div data-pagefind-ignore>
      <Breadcrumb trail={trail} />
    </div>

    {
      data.status !== 'published' && (
        <p class="banner" role="note">
          {data.status === 'archived' ? 'Archived: kept for the record; no longer maintained.' : `Preview only: this item is a ${data.status} and does not appear on the live site.`}
        </p>
      )
    }

    <ArtifactHeader entry={entry} />

    <MediaBlock entry={entry} />

    <div class="layout">
      {
        headings.filter((h) => h.depth === 2).length >= TOC_MIN_HEADINGS && (
          <aside class="side" data-pagefind-ignore>
            <TableOfContents headings={headings} />
          </aside>
        )
      }
      <div class:list={['body', 'measure-reading', { reading: entry.collection === 'writing' }]}>
        <Content />
      </div>
    </div>

    <Credits entry={entry} />

    <footer class="artifact-footer measure-reading" data-pagefind-ignore>
      <p class="small muted">Source: {data.source}</p>
      <RelatedRail entry={entry} />
      <Backlinks entry={entry} />
      <PrevNext entry={entry} />
      {
        data.skills?.length > 0 && (
          <p class="small muted skills-shown">
            Skills shown:{' '}
            {data.skills.map((s: string, i: number) => (
              <>
                {evidenced.has(s) ? <a href={`/skills/${s}/`}>{labelFor('skills', s)}</a> : labelFor('skills', s)}
                {i < data.skills.length - 1 ? ', ' : ''}
              </>
            ))}
          </p>
        )
      }
      {
        data.tags?.length > 0 && (
          <p class="small muted tags">
            Tags:{' '}
            {data.tags.map((t: string, i: number) => (
              <>
                <a href={`/tags/${t}/`}>{labelFor('tags', t)}</a>
                {i < data.tags.length - 1 ? ', ' : ''}
              </>
            ))}
          </p>
        )
      }
    </footer>
  </article>
</BaseLayout>
  )
}

<style>
  /* The contents nav precedes the body in the DOM, on screen, and in the tab order (W5 draws
     "On this page" first; WCAG 1.3.2 and 2.4.3): stacked below 1024 px, beside the body above it. */
  .layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .layout {
      flex-direction: row;
      align-items: flex-start;
    }
    .body {
      flex: 1 1 auto;
      min-width: 0;
    }
    .side {
      flex: 0 0 var(--width-sidebar);
    }
  }
  .side:empty {
    display: none;
  }
  .body :global(h2) {
    margin-top: var(--space-4);
  }
  .artifact-footer {
    margin-top: var(--space-4);
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
</style>
