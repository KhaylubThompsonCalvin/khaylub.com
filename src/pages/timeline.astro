---
import BaseLayout from '@layouts/BaseLayout.astro';
import TimelineList from '@components/TimelineList.astro';
import { timelineRows } from '@lib/catalog';
const rows = await timelineRows();
---

<BaseLayout title="Timeline" description="Launches, publications, courses completed, and site milestones, by date." current="timeline">
  <div class="measure-reading">
    <h1>Timeline</h1>
    <p class="muted">Authored events plus every published item, newest first.</p>
    <TimelineList rows={rows} all={rows} />
  </div>
</BaseLayout>
