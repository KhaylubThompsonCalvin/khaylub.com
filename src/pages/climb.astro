---
import BaseLayout from '@layouts/BaseLayout.astro';
import ClimbBand from '@components/ClimbBand.astro';
import ClimbDoor from '@components/ClimbDoor.astro';
import Doors from '@components/Doors.astro';
import ClimbMount from '@components/ClimbMount.astro';
---

<BaseLayout
  title="The climb"
  description="The original 3D experience of khaylub.com, ported from the June 2026 release and loaded only on request."
  current="climb"
  fullBleed
>
  <section class="climb-intro container">
    {/* The room's head: the poster band with the page's title (the visual redesign); still nothing of the scene loads. */}
    <ClimbBand standalone />
    <p class="measure">
      The first version of this site: one continuous scroll, a traveler walking from night into day,
      and a Phoenix near the end. It is the June 2026 scene ported into this site: the same models,
      camera, and beats, the video plates re-encoded, and the words as shipped. Press the button to
      load it; the home page is fast because nothing here downloads until you ask. Scroll to walk;
      the cursor steers the firebird near the summit; two of the original camp cards link to project
      pages and the three concept worlds say so plainly.
    </p>
    <ClimbDoor standalone />
  </section>

  {/* Full-bleed (W-Climb): the island spans the page between the intro and the doors. */}
  <ClimbMount />

  <section class="after container" aria-labelledby="after-heading">
    <h2 id="after-heading">After the climb</h2>
    <p class="measure">Where to go next.</p>
    <Doors compact />
    <p class="small muted">
      The frozen original also lives at{' '}
      <a href="https://v1.khaylub.com" rel="noopener noreferrer">v1.khaylub.com</a>, and the story of how it
      was preserved is in <a href="/notes/preserving-v1/">Preserving V1</a>. What the port keeps and what it
      leaves out is recorded in <a href="/experiments/the-climb/">the exhibit entry</a>.
    </p>
  </section>
</BaseLayout>

<style>
  .climb-intro {
    padding-top: var(--space-4);
    padding-bottom: var(--space-4);
  }
  .after {
    padding-top: var(--space-4);
    padding-bottom: var(--space-6);
  }
</style>
