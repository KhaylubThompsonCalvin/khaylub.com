---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { availability, monthLabel } from '@lib/profile';

const [entry] = await getCollection('resume');
if (!entry) throw new Error('content/profile/resume.md is missing');
const { Content } = await render(entry);
const avail = availability();
---

<BaseLayout title="Résumé" description="The résumé of Khaylub Thompson-Calvin as an HTML page, with the same PDF that is linked everywhere on the site." current="resume">
  <article class="measure-reading resume">
    <h1>Résumé</h1>
    <p class="meta">
      Revision {entry.data.revision}, {entry.data.as_of.toISOString().slice(0, 10)}.
      <a class="btn" href={entry.data.pdf}>Download the PDF</a>
    </p>
    <p class="availability">{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
    <div class="resume-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .availability {
    font-weight: 600;
  }
  .resume-body :global(h2) {
    margin-top: var(--space-4);
    padding-bottom: 0.25rem;
    border-bottom: 1px solid var(--line);
  }
  .resume-body :global(h3) {
    margin-top: var(--space-3);
  }
</style>
