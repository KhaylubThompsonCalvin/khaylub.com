---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { availability, identity, monthLabel } from '@lib/profile';

const [entry] = await getCollection('resume');
if (!entry) throw new Error('content/profile/resume.md is missing');
const { Content } = await render(entry);
const avail = availability();
const id = identity();
---

<BaseLayout
  title="Résumé"
  description={`The résumé of ${id.name} as an HTML page, revision ${entry.data.revision}, with the same PDF that is linked everywhere on the site.`}
  current="resume"
>
  <article class="measure-reading resume">
    <h1>Résumé</h1>
    <p class="cta-row">
      <a class="btn btn-primary" href={entry.data.pdf}>Download the PDF</a>
      <span class="muted">Revision {entry.data.revision}, {entry.data.as_of.toISOString().slice(0, 10)}.</span>
    </p>
    <p class="availability">{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
    <div class="resume-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style is:global>
  .resume-body h2 {
    margin-top: var(--space-4);
    padding-bottom: var(--space-half);
    border-bottom: 1px solid var(--line);
  }
  .resume-body h3 {
    margin-top: var(--space-3);
  }
</style>
