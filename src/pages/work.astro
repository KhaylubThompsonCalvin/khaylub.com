---
// Work: the fast path for hiring managers. Every fact on this page is read from content/:
// featured projects and evidence from the catalog; education, certifications, availability,
// identity, and the résumé metadata from the profile files. Nothing is typed here twice.
// The room (the visual redesign, document 65): the workshop, a plate with an ink rule and the
// counts of what the room holds; the featured projects as rule-topped entries, not boxes.
import BaseLayout from '@layouts/BaseLayout.astro';
import ArtifactCard from '@components/ArtifactCard.astro';
import EvidenceList from '@components/EvidenceList.astro';
import EducationList from '@components/EducationList.astro';
import CertificationList from '@components/CertificationList.astro';
import { featured, skillGroups, evidenceFor } from '@lib/catalog';
import { availability, identity, monthLabel, resumeMeta } from '@lib/profile';

const feat = await featured();
const groups = await skillGroups();
const tech = await evidenceFor('technologies');
const avail = availability();
const id = identity();
const resume = resumeMeta();
const skillCount = groups.reduce((n, g) => n + g.skills.length, 0);
const evidenceTotal = new Set(groups.flatMap((g) => g.skills.flatMap((s) => s.items.map((i) => i.data.slug)))).size;
---

<BaseLayout
  title="Work"
  description={`${feat.length} featured projects with code and results, ${skillCount} skills with evidence, education, and certifications of ${id.name}. The fast path for hiring managers.`}
  current="work"
>
  <div class="plate room-work page-intro">
    <h1>Work</h1>
    <p class="availability">{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
    <p class="measure">
      {feat.length} projects with code and results, the skills and technologies they show, and where I
      studied. The <a href="/resume/">résumé</a> has the same facts in one page.
    </p>
    <ul class="counts">
      <li><a href="#featured-heading"><b>{feat.length}</b> featured projects</a></li>
      <li><a href="#skills"><b>{skillCount}</b> skills with evidence</a></li>
      <li><a href="#technologies"><b>{tech.length}</b> technologies</a></li>
      <li><b>{evidenceTotal}</b> published pieces of proof</li>
    </ul>
  </div>

  <section class="section" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured projects</h2>
    <ul class="card-grid">
      {feat.map((e) => <li><ArtifactCard entry={e} detail /></li>)}
    </ul>
  </section>

  <section class="section" id="skills" aria-labelledby="skills-heading">
    <h2 id="skills-heading">Skills, with evidence</h2>
    <p class="muted measure">
      Each count is the number of published pieces of work on this site that show the skill, across
      {evidenceTotal} {evidenceTotal === 1 ? 'item' : 'items'}. Every item is linked; there are no self-ratings.
    </p>
    {
      groups.map((g) => (
        <div class="skill-group">
          <h3>{g.area}</h3>
          <EvidenceList kind="skills" items={g.skills} idPrefix="skill" />
        </div>
      ))
    }
  </section>

  <section class="section" id="technologies" aria-labelledby="technologies-heading">
    <h2 id="technologies-heading">Technologies, across projects</h2>
    <p class="muted measure">Tools and libraries named by the published work, with the items that use each one.</p>
    <EvidenceList kind="technologies" items={tech} idPrefix="technology" />
  </section>

  <section class="section measure" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <EducationList />
  </section>

  <section class="section measure" aria-labelledby="certs-heading">
    <h2 id="certs-heading">Certifications and training</h2>
    <CertificationList />
  </section>

  <section class="section" aria-labelledby="next-heading">
    <h2 id="next-heading">Résumé and contact</h2>
    <p class="actions">
      <a class="btn btn-primary" href="/resume/">Read the résumé</a>
      <a class="btn" href={resume.pdf}>Download the PDF</a>
      <a class="btn" href={`mailto:${id.email}`}>Email me</a>
    </p>
  </section>
</BaseLayout>

<style>
  .availability {
    font-weight: 600;
  }
  .skill-group {
    margin-bottom: var(--space-3);
  }
  .skill-group h3 {
    margin-bottom: var(--space-1);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
