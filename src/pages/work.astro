---
import BaseLayout from '@layouts/BaseLayout.astro';
import ArtifactCard from '@components/ArtifactCard.astro';
import { featured, skillsWithEvidence, routeFor } from '@lib/catalog';
import { education, certifications, availability, identity, monthLabel } from '@lib/profile';

const feat = await featured();
const skills = await skillsWithEvidence();
const edu = education();
const certs = certifications();
const avail = availability();
const id = identity();
---

<BaseLayout
  title="Work"
  description="Skills with evidence, three featured projects, education, and certifications. The fast path for hiring managers."
  current="work"
>
  <div class="measure">
    <h1>Work</h1>
    <p class="availability">{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
    <p>
      Three projects with code and results, the skills they show, and where I studied. The
      <a href="/resume/">résumé</a> has the same facts in one page.
    </p>
  </div>

  <section class="section" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured projects</h2>
    <ul class="card-grid">
      {feat.map((e) => <li><ArtifactCard entry={e} /></li>)}
    </ul>
  </section>

  <section class="section" aria-labelledby="skills" id="skills">
    <h2 id="skills-heading">Skills, with evidence</h2>
    <p class="muted measure">Each count is the number of published pieces of work on this site that show the skill.</p>
    <ul class="skills">
      {
        skills.map((s) => (
          <li>
            <span class="skill-label">{s.label}</span>
            <span class="badge">{s.count} {s.count === 1 ? 'piece' : 'pieces'} of evidence</span>
            <span class="small muted">
              {s.items.map((it, i) => (
                <>
                  <a href={routeFor(it)}>{it.data.title}</a>
                  {i < s.items.length - 1 ? ', ' : ''}
                </>
              ))}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section measure" aria-labelledby="education-heading">
    <h2 id="education-heading">Education</h2>
    <dl class="edu">
      {
        edu.entries.map((e) => (
          <div>
            <dt>
              {e.program}, {e.institution}
            </dt>
            <dd>
              {e.location} · {e.start} to {e.end}
              {e.note ? `, ${e.note.toLowerCase()}` : ''}
              {e.courses.length > 0 && (
                <ul>
                  {e.courses.map((c) => (
                    <li>
                      {c.name}: completed {c.completed}
                    </li>
                  ))}
                </ul>
              )}
              {e.highlights.length > 0 && (
                <ul>
                  {e.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section measure" aria-labelledby="certs-heading">
    <h2 id="certs-heading">Certifications and training</h2>
    <ul>
      {certs.items.map((c) => <li>{c.name}{c.issuer ? ` (${c.issuer}${c.years ? `, ${c.years}` : ''})` : ''}</li>)}
    </ul>
    {certs.planned.length > 0 && <p class="muted">Planned: {certs.planned.join(' and ')}</p>}
  </section>

  <section class="section" aria-labelledby="next-heading">
    <h2 id="next-heading">Résumé and contact</h2>
    <p class="actions">
      <a class="btn btn-primary" href="/resume/">Read the résumé</a>
      <a class="btn" href="/resume/Khaylub-Thompson-Calvin-Resume.pdf">Download the PDF</a>
      <a class="btn" href={`mailto:${id.email}`}>Email me</a>
    </p>
  </section>
</BaseLayout>

<style>
  .availability {
    font-weight: 600;
  }
  .skills {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-1);
  }
  .skills li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .skill-label {
    font-weight: 600;
    min-width: 12rem;
  }
  .edu dt {
    font-weight: 600;
  }
  .edu dd {
    margin: 0 0 var(--space-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>
