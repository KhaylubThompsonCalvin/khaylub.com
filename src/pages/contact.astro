---
// Contact (the 2026-10-10 polish): two columns from 1024 px. At the left the page's one primary
// action, Email me, with the address as plain text (a Copy button joins it when JavaScript runs),
// the résumé, and the reply time; at the right every way to reach the owner as rows with their
// values, and what he is a good fit for, built only from facts already on the site (the roles sought,
// the place, the Now line's Portland area). All from content/profile/. No form and no backend
// (decision recorded in the Phase 2 requirements): mailto only, no third-party request.
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactRows from '@components/profile/ContactRows.astro';
import { identity, availability, monthLabel, resumeMeta, now } from '@lib/profile';
import { ICONS } from '@lib/icons';
const id = identity();
const avail = availability();
const resume = resumeMeta();
const area = now().lines.some((l) => l.includes('Portland area')) ? 'Portland area' : undefined;
const fit = [
  { icon: 'work', label: 'Roles', value: avail.roles_sought.join('; ') },
  { icon: 'place', label: 'Based in', value: [id.location, area].filter(Boolean).join(', the ') },
  { icon: 'clock', label: 'Time zone', value: 'Pacific time' },
];
---

<BaseLayout title="Contact" description={`How to reach ${id.name}: email, GitHub, and LinkedIn.`} current="contact">
  <div class="split">
    <div class="stack">
      <header class="page-intro">
        <h1>Contact</h1>
        <p class="availability"><span class="status-dot" aria-hidden="true"></span>{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
        <p class="muted">{id.role_line} · {id.location}</p>
      </header>
      <p class="cta-row">
        <a class="btn btn-primary door" href={`mailto:${id.email}`}>Email me</a>
        <button class="btn door" type="button" data-copy={id.email} hidden>Copy address</button>
      </p>
      <p>
        <strong>{id.email}</strong>
        {id.response_time && <br />}
        {id.response_time && <span class="muted">{id.response_time}</span>}
      </p>
      <p><a class="btn" href={resume.pdf}>Download résumé</a></p>
    </div>

    <div class="stack">
      <section class="surface" aria-labelledby="ways-heading">
        <h2 id="ways-heading" class="module-heading">Ways to reach me</h2>
        <ContactRows values />
      </section>
      <section class="surface" aria-labelledby="fit-heading">
        <h2 id="fit-heading" class="module-heading">Good fit for</h2>
        <ul class="contact">
          {
            fit.map((f) => (
              <li>
                <p>
                  <span>
                    <svg aria-hidden="true" focusable="false" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5"><path d={ICONS[f.icon]} /></svg>
                    {f.label}
                  </span>
                  <span class="note">{f.value}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
