---
// Contact: the email first, as the page's one primary action, then every way to reach the owner as
// rows with icons (ContactRows, the same rows as the Home block), all from content/profile/.
// No form and no backend (decision recorded in the Phase 2 requirements): mailto only.
import BaseLayout from '@layouts/BaseLayout.astro';
import ContactRows from '@components/profile/ContactRows.astro';
import { identity, availability, monthLabel } from '@lib/profile';
const id = identity();
const avail = availability();
---

<BaseLayout title="Contact" description={`How to reach ${id.name}: email, GitHub, and LinkedIn.`} current="contact">
  <article class="measure">
    <header class="page-intro">
      <h1>Contact</h1>
      <p class="availability">{avail.statement} <small class="muted">(as of {monthLabel(avail.as_of)})</small></p>
    </header>
    <p class="cta-row">
      <a class="btn btn-primary" href={`mailto:${id.email}`}>Email me</a>
      <span><a href={`mailto:${id.email}`}>{id.email}</a>{id.response_time && <span class="muted"> {id.response_time}</span>}</span>
    </p>
    <section class="module boxed" aria-labelledby="ways-heading">
      <h2 id="ways-heading" class="module-heading">Ways to reach me</h2>
      <ContactRows plain />
    </section>
  </article>
</BaseLayout>

