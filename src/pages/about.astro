---
// About (the 2026-10-10 polish, the Home page's block language): the identity block (the portrait,
// the name, the role, the availability with its status light, the two doors), then blocks for the
// owner's words (verbatim), how he works (verbatim), Now, education, certifications and the
// planned ones as chips, the skills and technologies the published work shows as chips linking to
// their pages, interests, and the contact rows. All read from content/profile/ and the catalog.
import BaseLayout from '@layouts/BaseLayout.astro';
import IdentityCard from '@components/IdentityCard.astro';
import NowLines from '@components/NowLines.astro';
import EducationList from '@components/EducationList.astro';
import ContactRows from '@components/profile/ContactRows.astro';
import { identity, now, monthLabel, interests, certifications } from '@lib/profile';
import { termPages } from '@lib/catalog';
const id = identity();
const n = now();
const certs = certifications();
const groups = interests().groups.filter((g) => g.items.length > 0);
const skills = await termPages('skills');
const tech = await termPages('technologies');
---

<BaseLayout
  title="About"
  description={`Who ${id.name} is, how he works, what he is doing now, his education and training, and where to find him elsewhere.`}
  current="about"
>
  <header class="page-intro">
    <h1>About</h1>
  </header>
  <div class="bento about">
    <IdentityCard level="h2" />

    <section class="module" aria-labelledby="words-heading">
      <h2 id="words-heading" class="module-heading">In my words</h2>
      <p>
        I build for a better future, so the next generation starts further ahead than I did. I am a
        Computer Information Systems student making interactive 3D and tools for the web, with seven
        years of hands-on hardware repair, calibration, and testing behind me. This site is a record
        of the climb, not the arrival.
      </p>
    </section>

    <section class="module" aria-labelledby="how-heading">
      <h2 id="how-heading" class="module-heading">How I work</h2>
      <p>
        Methodically, from documentation, with every number traced to a source. The first version of
        this site, the data projects, and the notes here are all built the same way: finish the thing,
        measure it, write down what it cost.
      </p>
    </section>

    <section class="module" aria-labelledby="about-now-heading">
      <h2 id="about-now-heading" class="module-heading">Now <span class="as-of">as of {monthLabel(n.as_of)}</span></h2>
      <NowLines />
      <p class="block-go"><a href="/now/">The Now page</a></p>
    </section>

    <section class="module" aria-labelledby="edu-heading">
      <h2 id="edu-heading" class="module-heading">Education</h2>
      <EducationList />
    </section>

    <section class="module" aria-labelledby="certs-heading">
      <h2 id="certs-heading" class="module-heading">Certified and planned</h2>
      <ul class="chips">
        {certs.items.map((c) => <li class="chip">{c.name}{c.issuer ? `, ${c.issuer}` : ''}</li>)}
        {certs.planned.map((p) => <li class="chip">Planned: {p}</li>)}
      </ul>
    </section>

    <section class="module" aria-labelledby="skills-heading">
      <h2 id="skills-heading" class="module-heading">Skills and technologies</h2>
      <ul class="chips">
        {skills.map((s) => <li><a class="chip" href={`/skills/${s.slug}/`}>{s.label}</a></li>)}
        {tech.map((t) => <li><a class="chip" href={`/technologies/${t.slug}/`}>{t.label}</a></li>)}
      </ul>
      <p class="block-go"><a href="/work/">Each with the work that shows it</a></p>
    </section>

    {
      groups.length > 0 && (
        <section class="module" aria-labelledby="interests-heading">
          <h2 id="interests-heading" class="module-heading">Interests</h2>
          <ul class="chips">
            {groups.flatMap((g) => g.items.map((it) => <li><a class="chip" href={it.url ?? `/tags/${it.tag}/`}>{it.label}</a></li>))}
          </ul>
        </section>
      )
    }

    <section class="module" aria-labelledby="about-contact-heading">
      <h2 id="about-contact-heading" class="module-heading">Contact</h2>
      <ContactRows />
      <p class="block-go"><a href="/colophon/">How this site is built</a></p>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* About's blocks keep their own heights: the words are of different lengths. */
  .about {
    align-items: start;
  }
</style>
