---
import BaseLayout from '@layouts/BaseLayout.astro';
import IdentityCard from '@components/IdentityCard.astro';
import ClimbBand from '@components/ClimbBand.astro';
import NowLine from '@components/NowLine.astro';
import Top8 from '@components/Top8.astro';
import Details from '@components/profile/Details.astro';
import Contact from '@components/profile/Contact.astro';
import Writing from '@components/profile/Writing.astro';
import Library from '@components/profile/Library.astro';
import { identity, onRepeat, availability } from '@lib/profile';
import { published } from '@lib/catalog';
import { personAndWebsite } from '@lib/seo';

// The Home page is a grid of blocks (the owner's request of 2026-10-10, the developer-portfolio
// convention): each block a card with its small label and one action. The DOM order is the phone
// order: the identity block, the climb, Now, Looking for, the Top 8, Writing, the Library, Details,
// Contact. Two columns from 640 px; four from 1024 px. The identity block and the Top 8 run the full
// width; the climb takes two columns beside Now and Looking for; the rest pair up two by two, so no
// row leaves a hole at any width.
const id = identity();
const repeat = onRepeat();
const avail = availability();
const journal = (await published('journal')).slice(0, 5);
const jsonLd = await personAndWebsite();
---

<BaseLayout
  title="Home"
  description={`${id.name}: ${id.role_line.split(' · ')[0]} and builder. Projects, data work, Field Notes, and a library, with the original 3D climb one click away.`}
  current="home"
  jsonLd={jsonLd}
>
  <div class="bento">
    <IdentityCard />
    <ClimbBand />
    <NowLine />
    <section class="module" aria-labelledby="looking-heading">
      <h2 id="looking-heading" class="module-heading">Looking for</h2>
      <ul class="row-list">{avail.roles_sought.map((r) => <li>{r}</li>)}</ul>
      <p class="block-go"><a href="/resume/">Read the résumé</a></p>
    </section>
    <Top8 />
    <Writing />
    <Library />
    <Details />
    <Contact />
  </div>

  {
    journal.length > 0 && (
      <section class="section" aria-labelledby="journal-heading">
        <h2 id="journal-heading">Latest from the journal</h2>
        <ul>
          {journal.map((e) => (
            <li>
              <a href={`/journal/${e.data.slug}/`}>{e.data.title}</a>{' '}
              <span class="small muted">{e.data.date.toISOString().slice(0, 10)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    repeat.title && (
      <section class="section" aria-labelledby="repeat-heading">
        <h2 id="repeat-heading">On repeat</h2>
        <p>
          {repeat.url ? <a href={repeat.url} rel="noopener noreferrer">{repeat.title}</a> : repeat.title}
          {repeat.artist && ` by ${repeat.artist}`}
        </p>
      </section>
    )
  }
</BaseLayout>

<style is:global>
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-block);
    margin-bottom: var(--space-section);
  }
  /* Every block is a surface (base.css); blocks are not whole links, so they do not lift. A module
     is a column whose last action keeps to the foot, so a shorter block on a row ends level. */
  .bento > * {
    margin: 0;
  }
  .bento > .module {
    display: flex;
    flex-direction: column;
  }
  .bento > * > :last-child {
    margin-bottom: 0;
  }
  .bento > .climb-band {
    padding: 0;
  }
  /* A block's head is its kind label (base.css, .kind), not a second title. */
  .bento .module-heading {
    border: 0;
    padding: 0;
    margin-bottom: var(--space-2);
  }
  /* The climb's words keep to the left on their scrim, so the sun and the Wanderer stay clear. */
  @media (min-width: 640px) {
    .bento .climb-words {
      background: linear-gradient(to right, var(--scrim) 60%, transparent 85%);
    }
    .bento .climb-words > * {
      max-width: 20rem;
    }
  }
  .bento .top8 {
    max-width: none;
  }
  .block-go {
    margin-top: auto;
    padding-top: var(--space-1);
  }
  @media (min-width: 640px) {
    .bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bento > :is(.hero, .climb-band, [aria-labelledby='top8-heading']) {
      grid-column: span 2;
    }
  }
  @media (min-width: 1024px) {
    .bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .bento > * {
      grid-column: span 2;
    }
    .bento > :is(.hero, [aria-labelledby='top8-heading']) {
      grid-column: 1 / -1;
    }
    .bento > :is([aria-labelledby='now-heading'], [aria-labelledby='looking-heading']) {
      grid-column: span 1;
    }
  }
</style>
