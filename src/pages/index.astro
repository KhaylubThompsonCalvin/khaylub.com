---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProfileCover from '@components/ProfileCover.astro';
import AudiencePicker from '@components/AudiencePicker.astro';
import EndingBand from '@components/EndingBand.astro';
import ClimbBand from '@components/ClimbBand.astro';
import NowLine from '@components/NowLine.astro';
import Top8 from '@components/Top8.astro';
import Details from '@components/profile/Details.astro';
import Contact from '@components/profile/Contact.astro';
import AboutDrop from '@components/profile/AboutDrop.astro';
import SkillsDrop from '@components/profile/SkillsDrop.astro';
import Writing from '@components/profile/Writing.astro';
import Library from '@components/profile/Library.astro';
import { identity, onRepeat } from '@lib/profile';
import { published } from '@lib/catalog';
import { personAndWebsite } from '@lib/seo';

// The Home page is the cover profile (Layout B, Profile Themes spec 2026-10-10, section 3.3): the
// cover (the scene, the round photo, the name, the status, the quick links, the doors, Start here),
// then two columns from 1280 px (narrower, the Top 8's tiles would crowd). The main column: the Top 8
// (one list per audience), the climb, Writing, the Library, and the journal when it has entries. The
// side column: About me, Now, Details (with what the owner is looking for), Skills, Contact. The DOM
// order is the phone order.
const id = identity();
const repeat = onRepeat();
const journal = (await published('journal')).slice(0, 5);
const jsonLd = await personAndWebsite();
---

<BaseLayout
  title="Home"
  description={`${id.name}: ${id.role_line.split(' · ')[0]} and builder. Projects, data work, Field Notes, and a library, with the original 3D climb one click away.`}
  current="home"
  jsonLd={jsonLd}
>
  <ProfileCover />
  <AudiencePicker />
  <div class="profile-cols">
    <div class="bento">
      <Top8 audiences />
      <ClimbBand />
      <Writing />
      <Library />
      {
        journal.length > 0 && (
          <section class="section" aria-labelledby="journal-heading">
            <h2 id="journal-heading">Latest from the journal</h2>
            <ul>
              {journal.map((e) => (
                <li>
                  <a href={`/journal/${e.data.slug}/`}>{e.data.title}</a>{' '}
                  <span class="small muted">{e.data.date.toISOString().slice(0, 10)}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        repeat.title && (
          <section class="section" aria-labelledby="repeat-heading">
            <h2 id="repeat-heading">On repeat</h2>
            <p>
              {repeat.url ? (
                <a href={repeat.url} rel="noopener noreferrer">
                  {repeat.title}
                </a>
              ) : (
                repeat.title
              )}
              {repeat.artist && ` by ${repeat.artist}`}
            </p>
          </section>
        )
      }
    </div>
    <div class="bento">
      <AboutDrop />
      <NowLine />
      <Details />
      <SkillsDrop />
      <Contact />
    </div>
  </div>
  <EndingBand />
</BaseLayout>

<style is:global>
  /* Each column is a stack of blocks; every block is a surface (base.css). Two columns from 1280 px,
     the side column 20rem, so the Top 8 keeps four tiles across. About uses the same. */
  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap-block);
    align-content: start;
  }
  .bento > * {
    margin: 0;
  }
  .bento > .climb-band {
    padding: 0;
  }
  /* A block's head is its kind label (base.css, .kind), not a second title. */
  .bento .module-heading {
    border: 0;
    padding: 0;
    margin-bottom: var(--space-2);
  }
  /* The climb's words keep to the left on their scrim, so the sun and the Wanderer stay clear. */
  @media (min-width: 640px) {
    .bento .climb-words {
      background: linear-gradient(to right, var(--scrim) 45%, transparent 70%);
    }
    .bento .climb-words > * {
      max-width: 20rem;
    }
  }
  .bento .top8 {
    max-width: none;
  }
  .block-go {
    margin-top: auto;
    padding-top: var(--space-1);
  }
  .profile-cols {
    display: grid;
    gap: var(--gap-block);
    margin-bottom: var(--space-section);
  }
  @media (min-width: 1280px) {
    .profile-cols {
      grid-template-columns: minmax(0, 1fr) 20rem;
    }
  }
  /* About me's drop-down: a 44 px summary whose label says what a press does. The skills' "+N more"
     summary is a chip (base.css), already a 44 px target. */
  .about-drop summary {
    min-height: var(--target);
    display: flex;
    align-items: center;
    cursor: pointer;
    color: var(--accent);
  }
  .about-drop:not([open]) summary :last-child,
  .about-drop[open] summary :first-child {
    display: none;
  }
</style>
