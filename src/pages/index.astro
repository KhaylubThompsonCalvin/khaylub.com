---
import BaseLayout from '@layouts/BaseLayout.astro';
import IdentityCard from '@components/IdentityCard.astro';
import NowLine from '@components/NowLine.astro';
import Top8 from '@components/Top8.astro';
import Details from '@components/profile/Details.astro';
import Contact from '@components/profile/Contact.astro';
import Writing from '@components/profile/Writing.astro';
import Library from '@components/profile/Library.astro';
import { identity, onRepeat } from '@lib/profile';
import { published } from '@lib/catalog';
import { personAndWebsite } from '@lib/seo';

// The Home page is a profile (the design initiative's F5, vault document 65): the approved hero,
// then a module column (Now, Details, Contact) beside an editorial column (the Top 8, Writing, the
// Library). The DOM order is the reading order on a phone: hero, Now, the Top 8, Writing, the
// Library, Details, Contact; at 900 px the grid places the modules in their columns.
const id = identity();
const repeat = onRepeat();
const journal = (await published('journal')).slice(0, 5);
const jsonLd = await personAndWebsite();
---

<BaseLayout
  title="Home"
  description={`${id.name}: ${id.role_line.split(' · ')[0]} and builder. Projects, data work, Field Notes, and a library, with the original 3D climb one click away.`}
  current="home"
  jsonLd={jsonLd}
>
  <IdentityCard />
  <div class="profile">
    <div class="now"><NowLine /></div>
    <div class="main">
      <div class="top8-col"><Top8 /></div>
      <div class="writing"><Writing /></div>
      <div class="library"><Library /></div>
    </div>
    <div class="side">
      <Details />
      <Contact />
    </div>
  </div>

  {
    journal.length > 0 && (
      <section class="section" aria-labelledby="journal-heading">
        <h2 id="journal-heading">Latest from the journal</h2>
        <ul>
          {journal.map((e) => (
            <li>
              <a href={`/journal/${e.data.slug}/`}>{e.data.title}</a>{' '}
              <span class="small muted">{e.data.date.toISOString().slice(0, 10)}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    repeat.title && (
      <section class="section" aria-labelledby="repeat-heading">
        <h2 id="repeat-heading">On repeat</h2>
        <p>
          {repeat.url ? <a href={repeat.url} rel="noopener noreferrer">{repeat.title}</a> : repeat.title}
          {repeat.artist && ` by ${repeat.artist}`}
        </p>
      </section>
    )
  }
</BaseLayout>

<style>
  .profile {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: var(--space-section);
  }
  .main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  /* Every module keeps the section gap below it; the last one on the page gives it back. */
  .side > :global(.module:last-child) {
    margin-bottom: 0;
  }
  @media (min-width: 900px) {
    /* Two columns: Now and the facts on the left, the work on the right. The right column spans
       both rows; the second row takes the extra height so the facts sit right under Now. */
    .profile {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: var(--space-8);
      align-items: start;
    }
    .now {
      grid-column: 1;
      grid-row: 1;
    }
    .side {
      grid-column: 1;
      grid-row: 2;
    }
    .main {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .library :global(.module) {
      margin-bottom: 0;
    }
  }
  @media (min-width: 1200px) {
    .main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-8);
    }
    .top8-col {
      grid-column: 1 / -1;
    }
    .writing :global(.module) {
      margin-bottom: 0;
    }
  }
</style>
